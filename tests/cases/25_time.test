# time: "%d.%03du %d.%03ds %d.%03dr\n" por stdout
RE='[0-9]+\.[0-9]{3}u [0-9]+\.[0-9]{3}s [0-9]+\.[0-9]{3}r'
msh_run <<'IN'
time
time sleep 1
IN
expect_eq "$(wc -l < "$T/out" | tr -d " ")" 2 "líneas de stdout"
for n in 1 2; do echo "$(line $n)" | grep -Eqx "$RE" || fail "línea $n con formato incorrecto: '$(line $n)'"; done
r=$(line 2 | sed -nE "s/.* ([0-9]+)\.([0-9]{3})r$/\1\2/p"); r=$((10#${r:-0}))
[ "$r" -ge 950 ] && [ "$r" -lt 2000 ] || fail "time sleep 1 debería dar ~1.000r, dio $(line 2)"
